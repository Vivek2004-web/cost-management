# Backend Server Environment Configuration Example

# Server Port
PORT=5001

# Environment (development | production)
NODE_ENV=development

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_in_production_12345

# AWS Cost Explorer API Credentials (Optional: Leave empty to run in Demo Mode)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Database Configuration
DATABASE_PATH=./data/cloud_monitor.db
